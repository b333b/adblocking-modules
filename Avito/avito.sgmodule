#!name=Avito — AdBlock
#!desc=Removes ads/promos (home feed, search, favorites, item card, my listings) and blocks ad-tech and telemetry hosts.
#!category=AdBlock
#!homepage=https://github.com/b333b/adblocking-modules

[Rule]
# Ad exchanges and ad-tech pixels (host-level, no MITM needed)
DOMAIN-SUFFIX,buzzoola.com,REJECT
DOMAIN-SUFFIX,serving-sys.ru,REJECT
DOMAIN-SUFFIX,adriver.ru,REJECT
DOMAIN-SUFFIX,weborama-tech.ru,REJECT
DOMAIN,amc.yandex.ru,REJECT
DOMAIN,top-fwz1.mail.ru,REJECT
# Telemetry and in-app surveys (global: applies to every app using these SDKs)
DOMAIN,sentry-mobile.avito.ru,REJECT
DOMAIN-SUFFIX,tracker-api.vk-analytics.ru,REJECT
DOMAIN,analytics.adjust.com,REJECT
DOMAIN,analytics.adjust.io,REJECT
DOMAIN,report.appmetrica.yandex.net,REJECT
DOMAIN,firebaselogging-pa.googleapis.com,REJECT
DOMAIN,app-analytics-services.com,REJECT
DOMAIN,public-api.uxfeedback.ru,REJECT

[URL Rewrite]
# Avito ad server: the request (with full targeting payload) never leaves the device
^https?:\/\/(app|www)\.avito\.ru\/(api|web)\/\d+\/adv\/network\/banner - reject-dict
# Ad impression / click pixels
^https?:\/\/www\.avito\.ru\/web\/\d+\/adv\/network\/(view|click) - reject-200
# Carried over from the manual rules
^https?:\/\/[\w.-]*avito\.ru\/files\/avito\/reklama\/ - reject-img
^https?:\/\/www\.avito\.ru\/web\/1\/ft - reject
^https?:\/\/app\.avito\.ru\/api\/1\/enabler\/toggles - reject
^https?:\/\/stats\.avito\.ru\/api\/1\/stats\/realtime - reject

[Header Rewrite]
# The app asks for zstd first; force gzip on script-rewritten endpoints so the body is decodable
^https?:\/\/app\.avito\.ru\/api\/\d+\/(main\/items|items|items\/\d+\/banners|favorites\/items\/list|card\/items\/\d+|internalBannerRotation\/banners|serp\/profile\/items\/banner)(\?|$) header-replace Accept-Encoding gzip

[Script]
avito-ads = type=http-response,pattern=^https?:\/\/app\.avito\.ru\/api\/\d+\/(main\/items|items|items\/\d+\/banners|favorites\/items\/list|card\/items\/\d+|internalBannerRotation\/banners|serp\/profile\/items\/banner)(\?|$),requires-body=true,max-size=3145728,timeout=10,script-path=https://raw.githubusercontent.com/b333b/adblocking-modules/main/Avito/Script/avito.js

[MITM]
hostname = %APPEND% app.avito.ru, www.avito.ru, stats.avito.ru
