#!name=[AdBlock] Ozon Marketplace
#!desc=Removes sponsored banners, video ads, curtain pop-ups and ads inside search results
#!category=AdBlock
#!homepage=https://github.com/b333b/adblocking-modules
#!arguments=ad_widgets:true,curtains:true,grid_ad_banners:true,sponsored_products:true,extra:Add_components_here
#!arguments-desc=Each setting is true or false, except extra.\n\nad_widgets — sponsored banners, video ads, prize-draw banners, ad auto-refresh\ncurtains — pop-up curtain banners\ngrid_ad_banners — banner tiles labelled "Реклама" inside result grids\nsponsored_products — sponsored product tiles in search results\nextra — extra widget component names to drop, comma separated (leave empty for none)\n\nValues seen in captures, with the widget names they appear under:\nbanner — cms.dynamicBanner, promo banner block\ntextBlock — cms.dynamicTextBlock, promo text block\nbuttonWidget — cms.dynamicButton, promo button\ncellList — cms.cellList, skeeter.fintabStarActiveBalance\nnavigationSlider — cms.navigationSlider, express.cmsNavigationSlider\nuWidgetObject — cms.uWidgetObject, embedded promo block\npixel — cms.pixel, cart.pixel, tracking only (no visible content)\ninsight — search.insightBlock, promoted block in search\ntileScroll — search.insightSkuScroll, shelf.userHistory, product carousels\ntileGrid2 — shelf.infiniteScroll and other shelves, the main product grids\ntileGridMedium / tileGridMini — shelf.freshPersonal, shelf.cartShelf, recommendation shelves\ntwoCards — skeeter.twoCards, bank promo pair\ncbottomWidget — skeeter.fintabStaticWithAnalytics, fintab.fintabGetCurtainBannerManager\nstarPoints — skeeter.starPoints, loyalty promo\npremiumPoints — premium upsell\ninstallment — cart.creditPromo, installment promo in cart\nmarketingDetail — cart.marketingDetail, promo details in cart\nbigPromoPDP — marketing.bigPromoPDP, promo block on product pages\ncustomCell — express.favoriteCategoryPromo\nuserMarketingActionsSelector — express.userMarketingActionsSelector\nfeedbackTile — review prompt\nrateItems — rate-your-order prompt\n\nCaution: tileGrid2, tileGridMedium, tileGridMini and tileScroll carry real products, and pixel widgets can drive cart alerts.
[Script]
ozon-mp-composer = type=http-response,pattern=^https://api\.ozon\.ru/api/composer-api\.bx/(page|widget)/json/v2,requires-body=1,max-size=-1,timeout=10,argument={"ad_widgets":{{{ad_widgets}}},"curtains":{{{curtains}}},"grid_ad_banners":{{{grid_ad_banners}}},"sponsored_products":{{{sponsored_products}}},"extra":"{{{extra}}}"},script-path=https://raw.githubusercontent.com/b333b/adblocking-modules/main/Ozon/Script/ozon-marketplace.js
[MITM]
hostname = %APPEND% api.ozon.ru
