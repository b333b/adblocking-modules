#!name=[AdBlock] Ozon Bank
#!desc=Removes banner carousel, card offers and promo sections from the Ozon Bank app
#!category=AdBlock
#!homepage=https://github.com/b333b/adblocking-modules
#!arguments=carousel:true,card_offer:true,operations_banner:true,new_product:true,order_card:true,loyalty_promos:true
#!arguments-desc=Each setting is true or false.\n\ncarousel — banner slider on the main screen\ncard_offer — "Карта с выгодой…" / "Ozon Карта в корзине" block\noperations_banner — banner inside the operations list\nnew_product — "Новый счёт или продукт" button and card\norder_card — order-card section next to your cards\nloyalty_promos — "Выгода от партнёров" and "Розыгрыши и акции" on the Выгода screen
[Script]
ozon-bank-page = type=http-response,pattern=^https://finance\.ozon\.ru/m/lk/main(\?.*)?$,requires-body=1,max-size=-1,timeout=10,argument=carousel:{{{carousel}}}&card_offer:{{{card_offer}}}&operations_banner:{{{operations_banner}}}&new_product:{{{new_product}}}&order_card:{{{order_card}}}&loyalty_promos:{{{loyalty_promos}}},script-path=https://raw.githubusercontent.com/b333b/adblocking-modules/main/Ozon/Script/ozon-bank.js
ozon-bank-main = type=http-response,pattern=^https://finance\.ozon\.ru/apps/main/(_mf/info/MFEMainMobile|api/mainPage|api/updateMainPage)(\?.*)?$,requires-body=1,max-size=-1,timeout=10,argument=carousel:{{{carousel}}}&card_offer:{{{card_offer}}}&operations_banner:{{{operations_banner}}}&new_product:{{{new_product}}}&order_card:{{{order_card}}}&loyalty_promos:{{{loyalty_promos}}},script-path=https://raw.githubusercontent.com/b333b/adblocking-modules/main/Ozon/Script/ozon-bank.js
ozon-bank-loyalty = type=http-response,pattern=^https://finance\.ozon\.ru/apps/loyalty/_mf/info/MFBonuses(\?.*)?$,requires-body=1,max-size=-1,timeout=10,argument=carousel:{{{carousel}}}&card_offer:{{{card_offer}}}&operations_banner:{{{operations_banner}}}&new_product:{{{new_product}}}&order_card:{{{order_card}}}&loyalty_promos:{{{loyalty_promos}}},script-path=https://raw.githubusercontent.com/b333b/adblocking-modules/main/Ozon/Script/ozon-bank.js
ozon-bank-list = type=http-response,pattern=^https://finance\.ozon\.ru/apps/promo/api/banners/list(\?.*)?$,requires-body=1,max-size=-1,timeout=10,argument=carousel:{{{carousel}}}&card_offer:{{{card_offer}}}&operations_banner:{{{operations_banner}}}&new_product:{{{new_product}}}&order_card:{{{order_card}}}&loyalty_promos:{{{loyalty_promos}}},script-path=https://raw.githubusercontent.com/b333b/adblocking-modules/main/Ozon/Script/ozon-bank.js
[MITM]
hostname = %APPEND% finance.ozon.ru
