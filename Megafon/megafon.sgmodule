#!name=[AdBlock] MegaFon
#!desc=Removes promo banners, stories, pop-ups, personal and partner offers, loan ads, game center, tips, surveys, "new" badges, the VPN warning bar, chosen main-screen sections, the "Для меня" tab and analytics in the MegaFon app
#!category=AdBlock
#!homepage=https://github.com/b333b/adblocking-modules
#!arguments=banners:true,stories:true,popups:true,offers:true,loans:true,games:true,onboarding:true,surveys:true,badges:true,vpn_warning:true,for_me_tab:true,analytics:true,sections:Add_components_here,shortcuts:Add_components_here,extra_flags:Add_components_here
#!arguments-desc=On/off settings take true or false. Lists are joined with + (never commas) and may be left empty.\n\nbanners — promo banners (main, finance, family, promised payment screens)\nstories — stories row and stories inside screens\npopups — pop-up offers, in-app pop-up campaigns, "Финансовый помощник" consent pop-up\noffers — "Вам подарок", personal offers, partner offers, SmartShopping, promo tile in the services catalog\nloans — "Деньги" tab with loans and credit cards in Finance, and the "Деньги" shortcut (turn off if you have a loan taken through MegaFon)\ngames — Game Center and game teasers\nonboarding — "what's new" tips and onboarding stories\nsurveys — in-app surveys\nbadges — red "new" bubbles on menu items\nvpn_warning — "Отключите виртуальную частную сеть (VPN)" bar shown on every launch\nfor_me_tab — "Для меня" tab in the bottom menu\nanalytics — app telemetry and log shipping (Yandex Metrica, MyTracker and Varioqub are always blocked)\n\nsections — main-screen ("Связь") sections to hide. Available: mega5g (Мега5G), megafamily (МегаСемья block and its line under the remainders), cashback (Кешбэк), roaming (Роуминг)\n\nshortcuts — service-shelf items to hide. Available: start (Кинотеатр), megacinema (МегаКино), shop (Товары), money (Деньги; already hidden while loans is true), eve (Ева), additionalNumbers (Доп. номер), homeInternet (Домашний Интернет)\n\nextra_flags — web-app feature flags to switch off. Available:\nMain screen: showRemaindersOnMain, showTariffWidget, showTariffWidgetWithRemainders, showExpenses, showFutureExpenses, showChat, showIconBonusBalance, showHouseGroupProducts, showActivationSim, showSimOrder, showOrderEsim, showSimExchange, showEsimExchange, isEsimExchangeOtpEnabled (SMS code for eSIM exchange), showNumberTransfer\nServices: showRoamingInternetOptions, autoRoamingGoodbye, showAgentEve, showCallRecords\nFinance: showAutopayments, showAutopaymentsRefillByCard, showAutoVirtual, showPromisedPayments\nЕщё: showVacancies, showVipProgram, showSharedOpinion, showAppGuide, showWidgetSettings, showSMSForwarding, showNumberExchange, showNumberTransferAgreement, showPersonalDataUpdate, showSupportCall, showAdditionalNumbers, chatEnabled, inquiryEnabled, changeRegionAvailable, generalAvailabilityIMEI\nCommon: showNotifyCenter, showMultiaccount, showNewMultiaccount, showBlockNumber, showThemeSettings, showNickName, showUserProfileWidget, newChatAvailable\nTariff: showDelayedChange, showTargetChange

[Rule]
# Analytics hosts (Yandex Metrica, Varioqub, MyTracker), always blocked
RULE-SET,https://raw.githubusercontent.com/b333b/adblocking-modules/main/Megafon/Rules/analytics-true.list,REJECT

[Header Rewrite]
# Ask for gzip only on scripted endpoints so the body stays readable by the script
^https:\/\/(api\.megafon\.ru\/mlk\/api\/(appConfig\/wlk|promoBanner\/availableBanners|banners|promoOffers|mfo\/assent\/form|personaloffer\/availableContent|partnersoffer\/list|services\/availableServices\/categoriesList|onboardings\/list|configuration\/buttonBubble|superapp\/components|stories\/tags|logs\/severities)|lk\.megafon\.ru\/settings\.json|api\.inappstory\.ru\/v2\/(feed\/[\w-]+(\/[\w-]+)?|inappmessaging))(\?|$) header-replace Accept-Encoding gzip
# Page (index.html for every app route) and the VPN warning chunk: always fetch a full copy so the
# script can edit it; a 304 would make the web view reuse its stored, unedited copy
^https:\/\/lk\.megafon\.ru\/((?!track\/|public\/)[\w\/-]*|public\/rwlk\/vpnNotification\.[0-9a-f]+\.js)(\?|$) header-replace Accept-Encoding gzip
^https:\/\/lk\.megafon\.ru\/((?!track\/|public\/)[\w\/-]*|public\/rwlk\/vpnNotification\.[0-9a-f]+\.js)(\?|$) header-del If-None-Match
^https:\/\/lk\.megafon\.ru\/((?!track\/|public\/)[\w\/-]*|public\/rwlk\/vpnNotification\.[0-9a-f]+\.js)(\?|$) header-del If-Modified-Since

[Script]
megafon = type=http-response,pattern=^https:\/\/(api\.megafon\.ru\/mlk\/api\/(appConfig\/wlk|promoBanner\/availableBanners|banners|promoOffers|mfo\/assent\/form|personaloffer\/availableContent|partnersoffer\/list|services\/availableServices\/categoriesList|onboardings\/list|configuration\/buttonBubble|superapp\/components|stories\/tags|logs\/severities)|lk\.megafon\.ru\/settings\.json|api\.inappstory\.ru\/v2\/(feed\/[\w-]+(\/[\w-]+)?|inappmessaging))(\?|$),requires-body=1,max-size=-1,timeout=10,argument=banners:{{{banners}}}&stories:{{{stories}}}&popups:{{{popups}}}&offers:{{{offers}}}&loans:{{{loans}}}&games:{{{games}}}&onboarding:{{{onboarding}}}&surveys:{{{surveys}}}&badges:{{{badges}}}&vpn_warning:{{{vpn_warning}}}&for_me_tab:{{{for_me_tab}}}&analytics:{{{analytics}}}&sections:{{{sections}}}&shortcuts:{{{shortcuts}}}&extra_flags:{{{extra_flags}}},script-path=https://raw.githubusercontent.com/b333b/adblocking-modules/main/Megafon/Script/megafon.js
megafon-page = type=http-response,pattern=^https:\/\/lk\.megafon\.ru\/((?!track\/|public\/)[\w\/-]*|public\/rwlk\/vpnNotification\.[0-9a-f]+\.js)(\?|$),requires-body=1,max-size=-1,timeout=10,argument=banners:{{{banners}}}&stories:{{{stories}}}&popups:{{{popups}}}&offers:{{{offers}}}&loans:{{{loans}}}&games:{{{games}}}&onboarding:{{{onboarding}}}&surveys:{{{surveys}}}&badges:{{{badges}}}&vpn_warning:{{{vpn_warning}}}&for_me_tab:{{{for_me_tab}}}&analytics:{{{analytics}}}&sections:{{{sections}}}&shortcuts:{{{shortcuts}}}&extra_flags:{{{extra_flags}}},script-path=https://raw.githubusercontent.com/b333b/adblocking-modules/main/Megafon/Script/megafon.js

[MITM]
hostname = %APPEND% api.megafon.ru, lk.megafon.ru, api.inappstory.ru
